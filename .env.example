APP_ENV=development
METRICS_ENABLED=false
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-local-password
SESSION_HOURS=24
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Used by compose.notifications.yaml only
NOTIFICATIONS_ENABLED=true
NOTIFICATION_API_URL=http://notification-api:8000
NOTIFICATION_API_TIMEOUT=2
INTERNAL_SERVICE_TOKEN=replace-with-a-shared-local-token
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=replace-with-a-local-broker-password
RABBITMQ_VHOST=taskflow
RABBITMQ_EXCHANGE=taskflow.events
RABBITMQ_QUEUE=notification.events
VITE_NOTIFICATION_POLL_MS=5000
