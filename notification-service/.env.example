APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
NOTIFICATION_API_HOST_PORT=8001
NOTIFICATION_DB_HOST_PORT=5433
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025
POSTGRES_HOST=notification-db
POSTGRES_PORT=5432
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=replace-with-a-local-db-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=replace-with-a-local-broker-password
RABBITMQ_VHOST=taskflow
RABBITMQ_EXCHANGE=taskflow.events
RABBITMQ_QUEUE=notification.events
EVENT_MAX_RETRIES=3
EVENT_RETRY_INTERVAL_SECONDS=5,15,30
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=notifications@taskflow.test
SMTP_FROM_NAME=TaskFlow
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT=5
EMAIL_ENABLED=true
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_INTERVAL_SECONDS=5
INTERNAL_SERVICE_TOKEN=replace-with-a-shared-local-token
