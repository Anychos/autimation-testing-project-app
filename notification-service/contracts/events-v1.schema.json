  "discriminator": {
    "mapping": {
      "task.completed": "#/$defs/Completed",
      "task.created": "#/$defs/Created",
      "task.deleted": "#/$defs/Deleted",
      "task.updated": "#/$defs/Updated",
      "user.registered": "#/$defs/Registration"
    },
    "propertyName": "event_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Registration"
    },
    {
      "$ref": "#/$defs/Created"
    },
    {
