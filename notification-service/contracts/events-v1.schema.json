{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Completed": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "source": {
          "const": "taskflow-backend",
          "title": "Source",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "event_type": {
          "const": "task.completed",
          "title": "Event Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CompletedPayload"
        }
      },
      "required": [
        "event_id",
        "schema_version",
        "occurred_at",
        "source",
        "correlation_id",
        "user_id",
        "event_type",
        "payload"
      ],
      "title": "Completed",
      "type": "object"
    },
    "CompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 3,
          "pattern": "^[^\\s\\x00][^\\x00]*[^\\s\\x00]$",
          "title": "Title",
          "type": "string"
        },
        "status": {
          "const": "done",
          "title": "Status",
          "type": "string"
        },
        "recipient_email": {
          "format": "email",
          "maxLength": 254,
          "title": "Recipient Email",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "title",
        "status",
        "recipient_email"
      ],
      "title": "CompletedPayload",
      "type": "object"
    },
