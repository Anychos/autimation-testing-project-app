    {"id":7,"type":"timeseries","title":"Slowest endpoints","description":"Пять маршрутов с наибольшим P95 в каждом временном окне.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"topk(5, histogram_quantile(0.95, sum by (le, route, method) (rate(taskflow_http_request_duration_seconds_bucket{job=~\"${service:regex}\",instance=~\"${instance:regex}\",method=~\"${method:regex}\",route=~\"${route:regex}\",status=~\"${status:regex}\"}[2m]))))","legendFormat":"{{method}} {{route}}"}]},
