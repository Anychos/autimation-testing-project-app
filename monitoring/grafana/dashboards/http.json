    {"id":14,"type":"timeseries","title":"HTTP body sent","description":"Байты тела переданные ASGI-серверу, без заголовков.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":48,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"Bps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(taskflow_http_response_body_bytes_total{job=~\"${service:regex}\",instance=~\"${instance:regex}\",method=~\"${method:regex}\",route=~\"${route:regex}\",status=~\"${status:regex}\"}[2m]))","legendFormat":"{{instance}}"}]}
