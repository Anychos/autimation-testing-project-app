    {"id":9,"type":"timeseries","title":"Pool usage","description":"Доля занятых слотов от суммарной ёмкости пулов backend.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":32,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"percentunit","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(taskflow_db_pool_checked_out{job=~\"${service:regex}\",instance=~\"${instance:regex}\"}) / sum(taskflow_db_pool_capacity{job=~\"${service:regex}\",instance=~\"${instance:regex}\"})","legendFormat":"{{instance}}"}]},
