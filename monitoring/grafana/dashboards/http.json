    {"id":4,"type":"timeseries","title":"Status distribution","description":"Скорость ответов каждого HTTP-кода.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"reqps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by(status) (rate(taskflow_http_requests_total{job=~\"${service:regex}\",instance=~\"${instance:regex}\",method=~\"${method:regex}\",route=~\"${route:regex}\",status=~\"${status:regex}\"}[2m]))","legendFormat":"{{status}}"}]},
