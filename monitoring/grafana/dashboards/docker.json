{
  "uid": "taskflow-docker",
  "title": "Docker Resources",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Ресурсы Performance из cAdvisor. При отсутствии серий используйте docker stats и inspect_environment.py.",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "taskflow-prom"
        },
        "query": "label_values(container_last_seen, container_label_com_docker_compose_project)",
        "definition": "label_values(container_last_seen, container_label_com_docker_compose_project)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "taskflow-prom"
        },
        "query": "label_values(container_last_seen, name)",
        "definition": "label_values(container_last_seen, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {"id":1,"type":"timeseries","title":"CPU usage","description":"CPU-секунды за секунду.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"cores","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m])","legendFormat":"{{name}}"}]},
    {"id":2,"type":"timeseries","title":"CPU limit","description":"Квота / период; доступны контейнеры с положительной квотой.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"cores","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"(container_spec_cpu_quota{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"} > 0) / container_spec_cpu_period{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]},
    {"id":3,"type":"timeseries","title":"CPU throttled time","description":"Секунды throttling за секунду.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"rate(container_cpu_cfs_throttled_seconds_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m])","legendFormat":"{{name}}"}]},
    {"id":4,"type":"timeseries","title":"Memory usage","description":"Потребление памяти, включая кэш.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"bytes","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"container_memory_usage_bytes{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]},
    {"id":5,"type":"timeseries","title":"Memory working set","description":"Рабочий набор памяти.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"bytes","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]},
    {"id":6,"type":"timeseries","title":"Memory limit","description":"Лимит cgroup; без профиля может отражать память VM.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"bytes","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"container_spec_memory_limit_bytes{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]},
    {"id":7,"type":"timeseries","title":"Network received","description":"Скорость чтения по интерфейсам.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"Bps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by(name) (rate(container_network_receive_bytes_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m]))","legendFormat":"{{name}}"}]},
    {"id":8,"type":"timeseries","title":"Network transmitted","description":"Скорость записи по интерфейсам.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":24,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"Bps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by(name) (rate(container_network_transmit_bytes_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m]))","legendFormat":"{{name}}"}]},
    {"id":9,"type":"timeseries","title":"Disk reads","description":"Чтение по устройствам, доступным cAdvisor.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":32,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"Bps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by(name) (rate(container_fs_reads_bytes_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m]))","legendFormat":"{{name}}"}]},
    {"id":10,"type":"timeseries","title":"Disk writes","description":"Запись по устройствам, доступным cAdvisor.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":32,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"Bps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by(name) (rate(container_fs_writes_bytes_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}[2m]))","legendFormat":"{{name}}"}]},
    {"id":11,"type":"timeseries","title":"Seconds since last seen","description":"Пропажа ряда означает недоступность метрики или контейнера.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":40,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"time() - container_last_seen{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]},
    {"id":12,"type":"timeseries","title":"OOM events","description":"Количество OOM событий cAdvisor. RestartCount доступен в inspect_environment.py.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":40,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"container_oom_events_total{container_label_com_docker_compose_project=~\"${project:regex}\",name=~\"${container:regex}\"}","legendFormat":"{{name}}"}]}
  ]
}
