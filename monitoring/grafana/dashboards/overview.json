{
  "uid": "taskflow-overview",
  "title": "TaskFlow Performance Overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Локальные измерения TaskFlow. No data означает отсутствие измерений.",
  "templating": {
    "list": []
  },
  "panels": [
    {"id":1,"type":"timeseries","title":"Requests per second","description":"Средняя скорость запросов за две минуты.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"reqps","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(taskflow_http_requests_total{job=\"backend\"}[2m]))","legendFormat":"{{instance}}"}]},
    {"id":2,"type":"timeseries","title":"Observed requests","description":"Сумма счётчиков процессов в текущем запуске.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(taskflow_http_requests_total{job=\"backend\"})","legendFormat":"{{instance}}"}]},
    {"id":3,"type":"timeseries","title":"Successful requests","description":"Успешно завершённые HTTP-запросы с кодами 2xx.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(taskflow_http_requests_total{job=\"backend\",status=~\"2..\"})","legendFormat":"{{instance}}"}]},
    {"id":4,"type":"timeseries","title":"HTTP errors","description":"Доля 4xx и 5xx среди завершённых запросов.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"percentunit","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(taskflow_http_requests_total{job=\"backend\",status=~\"[45]..\"}[2m])) / sum(rate(taskflow_http_requests_total{job=\"backend\"}[2m]))","legendFormat":"{{instance}}"}]},
    {"id":5,"type":"timeseries","title":"P50 latency","description":"Квантиль из объединённых buckets за две минуты.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.5, sum by (le) (rate(taskflow_http_request_duration_seconds_bucket{job=\"backend\"}[2m])))","legendFormat":"{{instance}}"}]},
    {"id":6,"type":"timeseries","title":"P90 latency","description":"Квантиль из объединённых buckets за две минуты.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.9, sum by (le) (rate(taskflow_http_request_duration_seconds_bucket{job=\"backend\"}[2m])))","legendFormat":"{{instance}}"}]},
    {"id":7,"type":"timeseries","title":"P95 latency","description":"Квантиль из объединённых buckets за две минуты.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(taskflow_http_request_duration_seconds_bucket{job=\"backend\"}[2m])))","legendFormat":"{{instance}}"}]},
    {"id":8,"type":"timeseries","title":"P99 latency","description":"Квантиль из объединённых buckets за две минуты.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":24,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.99, sum by (le) (rate(taskflow_http_request_duration_seconds_bucket{job=\"backend\"}[2m])))","legendFormat":"{{instance}}"}]},
    {"id":9,"type":"timeseries","title":"Requests in flight","description":"Текущие запросы во всех процессах backend.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":32,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(taskflow_http_in_flight{job=\"backend\"})","legendFormat":"{{instance}}"}]},
    {"id":10,"type":"timeseries","title":"Backend CPU","description":"CPU в эквиваленте ядер, источник cAdvisor.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":32,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"cores","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"backend\"}[2m]))","legendFormat":"{{instance}}"}]},
    {"id":11,"type":"timeseries","title":"Backend working set","description":"Рабочий набор памяти backend, источник cAdvisor.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":40,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"bytes","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(container_memory_working_set_bytes{container_label_com_docker_compose_service=\"backend\"})","legendFormat":"{{instance}}"}]},
    {"id":12,"type":"timeseries","title":"Active database connections","description":"Активные подключения к основной базе.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":40,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(pg_stat_activity_count{state=\"active\",datname=\"taskflow_performance\"})","legendFormat":"{{instance}}"}]},
    {"id":13,"type":"timeseries","title":"RabbitMQ queue depth","description":"Готовые и неподтверждённые сообщения основной очереди.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":48,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"rabbitmq_detailed_queue_messages{queue=\"notification.events\"}","legendFormat":"{{instance}}"}]},
    {"id":14,"type":"timeseries","title":"Outbox backlog","description":"События в состоянии PENDING, включая отложенные повторы.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":48,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"taskflow_outbox_pending","legendFormat":"{{instance}}"}]},
    {"id":15,"type":"timeseries","title":"Email acceptance P95","description":"От occurred_at до принятия письма SMTP-сервером.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":0,"y":56,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(taskflow_smtp_event_lag_seconds_bucket[2m])))","legendFormat":"{{instance}}"}]},
    {"id":16,"type":"timeseries","title":"Scrape target availability","description":"1 — UP, 0 — DOWN. Исчезновение DNS-цели Worker даёт отсутствие ряда.","datasource":{"type":"prometheus","uid":"taskflow-prom"},"gridPos":{"x":12,"y":56,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"short","custom":{"spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"up","legendFormat":"{{job}} {{instance}}"}]}
  ]
}
